ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda-13.0/bin/nvcc

cflags = -pthread -Wno-unused-result -Wsign-compare -Wunreachable-code -DNDEBUG -g -fwrapv -O3 -Wall -O3 -fPIC -fPIC -I/home/eric-danziger/dev/NC2/nanochat/cuda_kernels/csrc -I/home/eric-danziger/dev/NC2/nanochat/cuda_kernels/cutlass/include -I/home/eric-danziger/dev/NC2/nanochat/cuda_kernels/cutlass/tools/util/include -I/home/eric-danziger/dev/nanochat/.venv-cuda13/lib/python3.10/site-packages/torch/include -I/home/eric-danziger/dev/nanochat/.venv-cuda13/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/usr/local/cuda-13.0/include -I/home/eric-danziger/dev/nanochat/.venv-cuda13/include -I/home/eric-danziger/.local/share/uv/python/cpython-3.10.19-linux-x86_64-gnu/include/python3.10 -c
post_cflags = -O3 -std=c++17 -DENABLE_SM120=1 -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=fused_look_around_flash_cuda
cuda_cflags = -I/home/eric-danziger/dev/NC2/nanochat/cuda_kernels/csrc -I/home/eric-danziger/dev/NC2/nanochat/cuda_kernels/cutlass/include -I/home/eric-danziger/dev/NC2/nanochat/cuda_kernels/cutlass/tools/util/include -I/home/eric-danziger/dev/nanochat/.venv-cuda13/lib/python3.10/site-packages/torch/include -I/home/eric-danziger/dev/nanochat/.venv-cuda13/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/usr/local/cuda-13.0/include -I/home/eric-danziger/dev/nanochat/.venv-cuda13/include -I/home/eric-danziger/.local/share/uv/python/cpython-3.10.19-linux-x86_64-gnu/include/python3.10 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -O3 --use_fast_math -std=c++17 -U__CUDA_NO_HALF_OPERATORS__ -U__CUDA_NO_HALF_CONVERSIONS__ -U__CUDA_NO_BFLOAT16_CONVERSIONS__ --expt-relaxed-constexpr --expt-extended-lambda -lineinfo -DCUTLASS_ENABLE_TENSOR_CORE_MMA=1 -DCUTE_SM90_EXTENDED_MMA_SHAPES_ENABLED -DCUTE_SM120_EXTENDED_MMA_SHAPES_ENABLED -DENABLE_SM120=1 -DCUTLASS_ARCH_MMA_SM120_SUPPORTED=1 -gencode=arch=compute_90,code=sm_90 -gencode=arch=compute_90a,code=sm_90a -gencode=arch=compute_120a,code=sm_120a -gencode=arch=compute_120a,code=compute_120a -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=fused_look_around_flash_cuda
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags







